---
import DomainPage from '../layouts/DomainPage.astro';
import LightingDimmer from '../components/LightingDimmer.astro';
import { MEDIA } from '../data/media';

const faq = [
  {
    q: 'מה זה פס צבירה מגנטי?',
    a: 'פרופיל שמותקן בתקרה ומוליך חשמל במתח נמוך. גופי התאורה ננעלים עליו במגנט, ואפשר להזיז, להוסיף או להחליף אותם לאורך הפס בלי לפתוח את התקרה.',
  },
  {
    q: 'אפשר לשקע פס צבירה מגנטי בתקרת גבס?',
    a: 'כן. הפרופילים מוטמעים בתקרת הגבס בקו נקי, או מותקנים על גבי התקרה כשאין אפשרות לשקע. את סוג ההתקנה קובעים בשלב התכנון לפי מבנה התקרה.',
  },
  {
    q: 'התאורה המגנטית נשלטת מהמתג החכם?',
    a: 'כן. כל גוף תאורה או קבוצת גופים מקבלים שליטה מהמתג, מהאפליקציה ומסצנות: עוצמה, כיבוי והדלקה, ושינוי גוון מלבן קר לצהוב חם.',
  },
  {
    q: 'איזו תאורה מגנטית מתאימה לסלון ולמטבח?',
    a: 'בסלון עובדים בדרך כלל עם שילוב של ספוטים מכוונים ופס אור רך לאווירה. במטבח מוסיפים אור ישיר ואחיד מעל משטח העבודה. מתכננים את זה יחד מול תוכנית התקרה.',
  },
];
---

<DomainPage
  faq={faq}
  title="תאורה מגנטית ופס צבירה מגנטי שקוע בגבס | לומרה"
  description="תאורה מגנטית חכמה: פסי צבירה מגנטיים שקועים בגבס, ספוטים, נברשות ותאורה אדריכלית, עם עמעום ושינוי גוון מהמתג או מהטלפון. תכנון והתקנה."
  path="/lighting/"
  h1="תאורה מגנטית שנבנית סביב העיצוב"
  lead="בלומרה התאורה היא חלק מהאדריכלות: פסי צבירה מגנטיים שקועים בגבס, ספוטים שזזים לאורך הפס, נברשות ותאורה מעוצבת. כל גוף מתעמעם ומשנה גוון מהמתג או מהטלפון."
  crumbs={[{ name: 'תאורה מגנטית וחכמה', path: '/lighting/' }]}
  image={MEDIA.pages.lighting}
  service={{ name: 'תאורה מגנטית וחכמה', serviceType: 'תכנון והתקנת תאורה מגנטית' }}
  whatsappMessage="היי, הגעתי מעמוד התאורה באתר של לומרה"
  featuresTitle="מה כוללת התאורה"
  features={[
    { title: 'פס צבירה מגנטי שקוע בגבס', text: 'פרופילים מגנטיים מינימליסטיים שמוטמעים בתקרה בקו נקי, או מותקנים על גבי התקרה. גופי התאורה ננעלים על הפס וזזים לאורכו.' },
    { title: 'גופים שמתחלפים בלי לגעת בתקרה', text: 'ספוטים, פסי אור ליניאריים וגופים זוויתיים באורכים שונים. משנים את התאורה בלי לשנות את התקרה.' },
    { title: 'עמעום וגוון', text: 'כל גוף מתעמעם ומשנה טמפרטורת צבע, מלבן קר לצהוב חם, ונכנס לסצנות של ערב, ארוחה או סרט.' },
    { title: 'נברשות ותאורה מעוצבת', text: 'מערכות כבלים מאפשרות הרכבה מודולרית של נברשות וגופים מעוצבים, לפי החזון של האדריכל.' },
  ]}
>
  <LightingDimmer room={MEDIA.room.image} roomAlt={MEDIA.room.alt} headingLevel="h2" showLink={false} />
</DomainPage>
