---
import DomainPage from '../layouts/DomainPage.astro';
import { MEDIA } from '../data/media';

const faq = [
  {
    q: 'אפשר להתקין רמקולים שקועים בתקרת גבס קיימת?',
    a: 'ברוב המקרים כן. בתכנון בודקים את עומק התקרה ואת מיקום הרמקולים ביחס לחדר ולמקום הישיבה.',
  },
  {
    q: 'אפשר לשמוע מוזיקה אחרת בכל חדר?',
    a: 'כן. מערכת המולטירום מחלקת את הבית לאזורי שמע, וכל אזור מנגן משהו אחר, בעוצמה משלו, מהטלפון.',
  },
  {
    q: 'המערכת עובדת עם שירותי סטרימינג?',
    a: 'כן, כולל TIDAL. מנגנים מהאפליקציה כמו מכל נגן אחר.',
  },
];
---

<DomainPage
  faq={faq}
  title="רמקולים שקועים בתקרה ומערכת שמע מולטירום | לומרה"
  description="מערכת שמע לבית חכם: רמקולים שקועים בתקרת גבס ובקירות, רמקולים על פסי התאורה המגנטיים ומולטירום בשליטה מהטלפון. תכנון אקוסטי והתקנה."
  path="/audio/"
  h1="סאונד בכל חדר, בלי רמקול אחד בעין"
  lead="בלומרה המוזיקה היא חלק מהאדריכלות. רמקולים שקועים בגבס ובקירות, רמקולים זעירים על פסי התאורה, ומערכות Hi‑End למי שרוצה יותר. הכול בשליטה מהטלפון."
  crumbs={[{ name: 'שמע נסתר ומולטירום', path: '/audio/' }]}
  image={MEDIA.pages.audio}
  service={{ name: 'מערכות שמע ומולטירום', serviceType: 'התקנת רמקולים שקועים ומערכת שמע לבית' }}
  whatsappMessage="היי, הגעתי מעמוד מערכות השמע באתר של לומרה"
  features={[
    { title: 'רמקולים שקועים ונסתרים', text: 'רמקולים שמותקנים בקו אפס בתוך תקרות גבס, קירות וחללים נסתרים. מראה נקי, בלי קופסאות גלויות.' },
    { title: 'רמקולים על פסי התאורה', text: 'רמקולים זעירים שמשתלבים על פסי התאורה המגנטיים, ומפזרים סאונד אחיד בחלל כחלק מהעיצוב.' },
    { title: 'מערכות Hi‑End בהתאמה אישית', text: 'תכנון מערכות אודיו עילית ורמקולים מוגברים, מותאמים אקוסטית לחדר ולצרכים שלכם.' },
    { title: 'מולטירום מהנייד', text: 'אזורי שמע נפרדים, עוצמה נפרדת בכל חדר, והפלייליסט שלכם מכל מקום בבית.' },
  ]}
/>
