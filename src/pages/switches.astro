---
import DomainPage from '../layouts/DomainPage.astro';
import SwitchShowcase from '../components/SwitchShowcase.astro';
import { MEDIA } from '../data/media';

const faq = [
  {
    q: 'במה המתג של לומרה שונה ממתג חכם רגיל?',
    a: 'רוב המתגים החכמים מחליפים מפסק קיים ונשארים קשורים לחיווט שמאחוריו. המתג של לומרה הוא חלק ממערכת שבה החשמל מגיע ישירות לגופי התאורה, והמתג שולט בהם באלחוט. לכן אפשר למקם אותו בכל נקודה על הקיר.',
  },
  {
    q: 'אפשר לשלוט בתריסים, בדוד ובמזגן מאותו מתג?',
    a: 'כן. מאותו מסך שולטים בתאורה, בתריסים, בדוד ובמזגן, וגם בסצנות שמפעילות כמה דברים יחד בלחיצה אחת.',
  },
  {
    q: 'אפשר לשנות את העיצוב ואת הכיתוב אחרי ההתקנה?',
    a: 'כן. הרקע, ערכת העיצוב והכיתוב בעברית משתנים מהאפליקציה, בלי לפרק את המתג ובלי להחליף חלקים.',
  },
  {
    q: 'המתג עובד עם עוזרים קוליים?',
    a: 'כן. המערכת עובדת עם Alexa ועם Google Assistant, לצד המתג והאפליקציה.',
  },
];
---

<DomainPage
  faq={faq}
  title="מתגים חכמים ופאנל שליטה עם מסך מגע בעברית | לומרה"
  description="מתג חכם עם מסך מגע וכיתוב בעברית: תאורה, עמעום, תריסים, דוד ומזגן ממקום אחד. אלחוטי, בלי חציבה, עם עיצוב שמתחלף מהאפליקציה."
  path="/switches/"
  h1="מתגים חכמים שמדברים עברית"
  lead="המתג הוא הדבר הראשון שנוגעים בו בבית. בלומרה הוא מסך מגע מעוצב ואלחוטי, שמפעיל תאורה, תריסים, מזגן ודוד, ומציג את שמות החדרים והסצנות בעברית."
  crumbs={[{ name: 'מתגים חכמים', path: '/switches/' }]}
  image={MEDIA.pages.switches}
  service={{ name: 'מתגים חכמים ופאנלי שליטה', serviceType: 'התקנת מתגים חכמים לבית חכם' }}
  whatsappMessage="היי, הגעתי מעמוד המתגים החכמים באתר של לומרה"
  featuresTitle="מה המתג יודע לעשות"
  features={[
    { title: 'מסך אחד במקום שורת מפסקים', text: 'סדרת L10 מחליפה כמה מפסקים רגילים ביחידה אחת: הדלקה וכיבוי, עמעום, תריסים וסצנות אווירה בלחיצה אחת.' },
    { title: 'כיתוב בעברית שמשתנה מתי שרוצים', text: 'שמות החדרים והסצנות מופיעים בעברית, ואפשר לשנות אותם מהאפליקציה בכל רגע.' },
    { title: 'עיצוב שמתחלף בלחיצה', text: 'Theme Flow מחליף את מראה המסך מהאפליקציה: Classic Gold לסלון, Kids Play לחדר הילדים. בלי לפרק ובלי להחליף חלקים.' },
    { title: 'חיישן קרבה ושליטה קולית', text: 'המסך מתעורר כשמתקרבים אליו, ועובד גם עם Alexa ועם Google.' },
    { title: 'אלחוטי, בלי חציבה', text: 'המתג משדר אלחוטית, ולכן אפשר להוסיף נקודת שליטה או להזיז אותה בלי לפתוח קיר.' },
    { title: 'מתג לכל צורך', text: 'תאורה ועמעום, תריס חשמלי, דוד, מזגן ותרחישים. כל מתג מוגדר לפי החדר שבו הוא נמצא.' },
  ]}
>
  <SwitchShowcase screens={MEDIA.switchScreens} showLink={false} />
</DomainPage>
