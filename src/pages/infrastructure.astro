---
import DomainPage from '../layouts/DomainPage.astro';
import InfraXray from '../components/InfraXray.astro';
import { MEDIA } from '../data/media';
import { SITE } from '../data/site';

const faq = [
  {
    q: 'מה ההבדל בין בית חכם אלחוטי לבית חכם קווי?',
    a: 'במערכת קווית כל נקודת שליטה מחוברת בכבל, ואת הצנרת צריך לתכנן מראש. בלומרה השליטה אלחוטית והחשמל מגיע ישירות לגופי התאורה, כך שהתשתית פשוטה יותר ונשארת גמישה גם אחרי שהקירות נסגרו.',
  },
  {
    q: 'האם הבית ממשיך לעבוד בלי אינטרנט?',
    a: 'כן. המתגים מתקשרים ישירות עם המערכת ולא דרך ה־Wi‑Fi. שליטה מרחוק מחוץ לבית דורשת חיבור לאינטרנט.',
  },
  {
    q: 'מתי כדאי לפנות אליכם בתהליך הבנייה?',
    a: 'הכי טוב בשלב תוכנית החשמל. כך החיסכון בצנרת ובנקודות נכנס כבר לתכנון, והאדריכל מקבל חופש מלא במיקום המתגים והתאורה.',
  },
  {
    q: 'אפשר לשלוח לכם תוכנית חשמל לבדיקה?',
    a: 'כן. אפשר לשלוח את התוכנית בוואטסאפ, או להעלות אותה למנתח תוכניות החשמל באתר ולקבל הצעה ראשונית למפרט.',
  },
];
---

<DomainPage
  faq={faq}
  title="תשתית לבית חכם בלי חציבות | לומרה"
  description="איך בונים בית חכם בלי חציבות: החשמל מגיע ישירות לגופי התאורה והשליטה עוברת באלחוט. פחות צנרת ונקודות חשמל, יותר חופש תכנון. שלחו תוכנית חשמל לבדיקה."
  path="/infrastructure/"
  h1="החשמל הולך למנורה. השליטה עוברת באוויר."
  lead="עד היום כל מתג דרש חציבה, צינור וחוטים. בלומרה מפרידים בין החשמל לשליטה: הכוח מגיע ישירות לגופי התאורה, והמתג הופך לשלט חכם ואלחוטי."
  crumbs={[{ name: 'תשתית בלי חציבות', path: '/infrastructure/' }]}
  image={MEDIA.pages.infrastructure}
  service={{ name: 'תכנון תשתית לבית חכם', serviceType: 'תכנון חשמל ותשתית לבית חכם' }}
  whatsappMessage="היי, הגעתי מעמוד התשתית באתר של לומרה ואשמח שתבדקו תוכנית חשמל"
  featuresTitle="מה זה משנה בפרויקט"
  features={[
    { title: 'פחות צנרת ונקודות חשמל', text: 'אין צנרת שיורדת מכל מנורה אל המתג. החיסכון בחומר ובשעות עבודה מתחיל כבר בתוכנית החשמל.' },
    { title: 'חופש לשנות', text: 'הזזתם רהיט? המתג זז איתו. אפשר להוסיף נקודת שליטה גם אחרי שהקירות נסגרו.' },
    { title: 'עובד גם בלי Wi‑Fi', text: 'המתגים מתקשרים ישירות עם המערכת, כך שהבית ממשיך לעבוד גם כשהאינטרנט נופל.' },
    { title: 'תכנון מתוך תוכנית החשמל', text: 'שלחו את תוכנית החשמל, ונציע מפרט לומרה לכל חדר: מתגים, תאורה, שמע ואקלים.' },
  ]}
  ctaText="שלחו לנו את תוכנית החשמל, או העלו אותה למנתח התוכניות, ונחזור עם מפרט ראשוני לכל חדר."
>
  <InfraXray heading="ככה זה נראה מאחורי הקיר" ctaHref={SITE.toolUrl} ctaLabel="העלאת תוכנית למנתח" />
</DomainPage>
