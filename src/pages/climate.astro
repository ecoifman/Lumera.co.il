---
import DomainPage from '../layouts/DomainPage.astro';
import { MEDIA } from '../data/media';

const faq = [
  {
    q: 'אפשר להדליק את המזגן מהדרך הביתה?',
    a: 'כן. מהאפליקציה, מכל מקום, או אוטומטית לפי תזמון, כך שהבית כבר נעים כשמגיעים.',
  },
  {
    q: 'המערכת עובדת עם המזגנים שכבר יש בבית?',
    a: 'ברוב המקרים כן. מזגנים עם שלט נשלטים באינפרא־אדום, ומערכות VRF מתחברות דרך ממשק ייעודי. את הדגם הספציפי בודקים בתכנון.',
  },
  {
    q: 'אפשר לשלוט בדוד ובתריסים מאותו מקום?',
    a: 'כן. הדוד, התריסים ומנועי ההצללה נשלטים מהמתג ומהאפליקציה, עם תזמונים לפי שעה או לפי השמש.',
  },
];
---

<DomainPage
  faq={faq}
  title="שליטה במזגן, בדוד ובתריסים מהטלפון | לומרה"
  description="אקלים חכם לבית: שליטה במזגנים ו־VRF, חימום תת־רצפתי, דוד, בריכה, תריסים והצללה, עם תזמונים וחיסכון באנרגיה. הכול מהמתג או מהטלפון."
  path="/climate/"
  h1="הבית מתכוונן לפני שהגעתם"
  lead="המערכת לומדת את הרגלי הבית, מנהלת את הטמפרטורה בחיסכון באנרגיה, ודואגת שיהיה נעים עוד לפני שנכנסתם הביתה. בחורף ובקיץ."
  crumbs={[{ name: 'אקלים, הצללה ואנרגיה', path: '/climate/' }]}
  image={MEDIA.pages.climate}
  service={{ name: 'אקלים, הצללה ואנרגיה בבית חכם', serviceType: 'שליטה חכמה במיזוג, חימום, דוד ותריסים' }}
  whatsappMessage="היי, הגעתי מעמוד האקלים והתריסים באתר של לומרה"
  features={[
    { title: 'מיזוג אוויר חכם, כולל VRF', text: 'שליטה במזגנים נסתרים ועיליים ובמערכות VRF. טמפרטורה שונה בכל חדר, וכיבוי אוטומטי כשהבית ריק.' },
    { title: 'חימום תת־רצפתי', text: 'ניהול אזורי של חימום רצפתי, במים או בחשמל, בתזמונים חכמים שמונעים בזבוז אנרגיה.' },
    { title: 'דוד, בריכה וג׳קוזי', text: 'שליטה בחימום המים, במשאבת הבריכה ובסינון, כדי שיהיו מים חמים בדיוק כשצריך.' },
    { title: 'תריסים והצללה', text: 'מנועי הצללה ותריסים חשמליים שנפתחים ונסגרים לפי השעה והשמש, או בלחיצה אחת על המתג.' },
    { title: 'חיישני אקלים ואיכות אוויר', text: 'ניטור של טמפרטורה, לחות ו־CO2, והפעלה אוטומטית של אוורור או מיזוג כשצריך.' },
  ]}
/>
