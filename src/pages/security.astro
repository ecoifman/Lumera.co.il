---
import DomainPage from '../layouts/DomainPage.astro';
import { MEDIA } from '../data/media';

const faq = [
  {
    q: 'אפשר לפתוח את הדלת לאורח מרחוק?',
    a: 'כן. דרך אינטרקום הווידאו והאפליקציה רואים מי בדלת ופותחים לו מכל מקום, והכניסה נרשמת ביומן.',
  },
  {
    q: 'מה קורה כשמתגלה נזילה?',
    a: 'חיישן ההצפה מפעיל סגירה אוטומטית של ברז המים הראשי ושולח התראה לטלפון, כדי למנוע נזק לפני שמישהו שם לב.',
  },
  {
    q: 'המצלמות שולחות התראה על כל תנועה?',
    a: 'המצלמות האנליטיות לומדות את סביבת הבית ומבחינות בין תנועה שגרתית לבין חשד, כך שמגיעות פחות התראות סרק.',
  },
];
---

<DomainPage
  faq={faq}
  title="מצלמות אבטחה, מנעול חכם ואזעקה לבית פרטי | לומרה"
  description="אבטחה לבית חכם: מצלמות אבטחה חכמות, מנעול חכם ואינטרקום וידאו, גלאים ואזעקה, וחיישן הצפה שסוגר את ברז המים. צפייה ושליטה מכל מקום."
  path="/security/"
  h1="אבטחה שרואה, נועלת ומגיבה"
  lead="מעטפת הגנה מלאה לבית ולמשפחה: מצלמות חכמות, בקרת כניסה, חיישנים ואזעקה ומניעת נזקי מים. צפייה ושליטה מכל מקום, בלי לפגוע בעיצוב הבית."
  crumbs={[{ name: 'אבטחה ובקרת כניסה', path: '/security/' }]}
  image={MEDIA.pages.security}
  service={{ name: 'אבטחה ובקרת כניסה לבית חכם', serviceType: 'התקנת מצלמות אבטחה ומנעול חכם' }}
  whatsappMessage="היי, הגעתי מעמוד האבטחה באתר של לומרה"
  features={[
    { title: 'מצלמות אבטחה חכמות', text: 'מצלמות אנליטיות שלומדות את סביבת הבית ומבחינות בין תנועה שגרתית לאיום אמיתי. בעיצוב מינימליסטי שנטמע באדריכלות.' },
    { title: 'בקרת כניסה ומנעול חכם', text: 'שערים ודלתות עם זיהוי ביומטרי, קודנים ואינטרקום וידאו. פתיחה מרחוק לאורחים ויומן כניסות בזמן אמת.' },
    { title: 'חיישנים ואזעקה', text: 'גלאים סמויים שמשתלבים בקירות ובתקרה, מסונכרנים עם התאורה להרתעה ולתגובה מיידית.' },
    { title: 'מניעת נזקי מים ואש', text: 'גילוי מוקדם של הצפה או נזילה סוגר אוטומטית את ברז המים הראשי, לצד התראות על עשן וחום קיצוני.' },
  ]}
/>
