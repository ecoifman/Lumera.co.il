---
import DomainPage from '../../layouts/DomainPage.astro';
import { MEDIA } from '../../data/media';

const faq = [
  {
    q: 'איך לומרה משתלבת בתכנון שלי?',
    a: 'אנחנו עובדים מול תוכנית החשמל והתקרות: מציעים מיקומי שליטה, תאורה ושמע לפי העיצוב, ומחזירים מפרט ברור לכל חדר.',
  },
  {
    q: 'אפשר לבחור את מראה המתגים?',
    a: 'כן. מסך המתג מקבל רקע, ערכת עיצוב וכיתוב בעברית, ואפשר לשנות אותם מהאפליקציה גם אחרי המסירה.',
  },
  {
    q: 'יש קטלוג ומפרטים להורדה?',
    a: 'כן. כתבו לנו בוואטסאפ ונשלח קטלוג תאורה ומתגים ומפרט טכני מעודכן לפרויקט.',
  },
];
---

<DomainPage
  faq={faq}
  title="בית חכם לאדריכלים ומעצבי פנים | לומרה"
  description="בית חכם שמשרת את העיצוב: מתגים אלחוטיים במקום שמתאים לתכנון, תאורה מגנטית שקועה בגבס ושמע נסתר. קטלוגים ומפרט לכל חדר לאדריכלים ומעצבי פנים."
  path="/professionals/architects/"
  h1="מתג במקום שמתאים לעיצוב, לא לצנרת"
  lead="כשהשליטה אלחוטית, מיקום המתגים נקבע לפי העיצוב והריהוט. כשהתאורה מגנטית, גופי התאורה זזים לפי הצורך, והקירות נשארים נקיים."
  crumbs={[
    { name: 'לאנשי מקצוע', path: '/professionals/' },
    { name: 'אדריכלים ומעצבי פנים', path: '/professionals/architects/' },
  ]}
  image={MEDIA.pages.architects}
  service={{ name: 'בית חכם לאדריכלים ומעצבי פנים', serviceType: 'מפרט ותכנון בית חכם לפרויקטי אדריכלות' }}
  whatsappMessage="היי, אני אדריכל/ית או מעצב/ת פנים ואשמח לקטלוג ולמפרט של לומרה"
  featuresTitle="מה מקבלים בתכנון"
  features={[
    { title: 'חופש במיקום השליטה', text: 'המתג משדר אלחוטית, ולכן הוא יכול לשבת ליד המיטה, על אי המטבח או בכל נקודה אחרת שמתאימה לתכנון.' },
    { title: 'תאורה אדריכלית נקייה', text: 'פסי צבירה מגנטיים דקים שמשתלבים בקו התקרה, וגופים שמתחלפים לאורכם בלי לגעת בגבס.' },
    { title: 'שמע שלא רואים', text: 'רמקולים שקועים בתקרה ובקירות, ורמקולים זעירים על פסי התאורה, בלי קופסאות על הקיר.' },
    { title: 'מפרט ברור לכל חדר', text: 'רשימת מתגים, תאורה ונקודות שליטה לכל חלל, שמתאימה לתוכנית החשמל ולשפה העיצובית.' },
  ]}
/>
