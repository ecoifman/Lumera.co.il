---
import DomainPage from '../../layouts/DomainPage.astro';
import { MEDIA } from '../../data/media';

const faq = [
  {
    q: 'מה צריך כדי להצטרף לרשת המתקינים?',
    a: 'כתבו לנו בוואטסאפ עם פרטים על הניסיון שלכם, ונתאם שיחת היכרות והכשרה.',
  },
  {
    q: 'מה כוללת ההכשרה?',
    a: 'את שיטת ההתקנה של לומרה, הגדרת המתגים והמערכת, ועבודה מסודרת מול המפרט של כל פרויקט.',
  },
  {
    q: 'יש ליווי טכני בשטח?',
    a: 'כן. מתקינים ברשת מקבלים ליווי טכני מצוות לומרה לאורך הפרויקט.',
  },
];
---

<DomainPage
  faq={faq}
  title="התקנת בית חכם לחשמלאים: רשת המתקינים | לומרה"
  description="חשמלאים ומתקיני בית חכם: הצטרפו לרשת המתקינים המוסמכים של לומרה. הכשרה, שיטת התקנה מתועדת וליווי טכני בהתקנת בית חכם אלחוטי בלי חציבות."
  path="/professionals/electricians/"
  h1="מתקינים לפי שיטה מתועדת"
  lead="לומרה בונה רשת של מתקינים מוסמכים. חשמלאים שמצטרפים מקבלים הכשרה על המערכת, שיטת עבודה מתועדת וליווי טכני לאורך הפרויקט."
  crumbs={[
    { name: 'לאנשי מקצוע', path: '/professionals/' },
    { name: 'חשמלאים ומתקינים', path: '/professionals/electricians/' },
  ]}
  image={MEDIA.pages.electricians}
  service={{ name: 'רשת מתקינים מוסמכים לבית חכם', serviceType: 'הכשרה וליווי מתקיני בית חכם' }}
  whatsappMessage="היי, אני חשמלאי/ת ורוצה להצטרף לרשת המתקינים של לומרה"
  ctaTitle="הצטרפו לרשת המתקינים"
  ctaText="ספרו לנו על הניסיון שלכם ועל האזור שבו אתם עובדים, ונתאם שיחת היכרות."
  featuresTitle="מה מקבלים ברשת"
  features={[
    { title: 'הכשרה על המערכת', text: 'מתקינים לומדים את המתגים, התאורה והמערכת לפני הפרויקט הראשון.' },
    { title: 'שיטה מתועדת', text: 'אותו סדר עבודה בכל פרויקט, מהמפרט ועד המסירה, כך שהתוצאה אחידה.' },
    { title: 'פחות עבודות חציבה', text: 'החשמל מגיע ישירות לתאורה והשליטה אלחוטית, ולכן ההתקנה נקייה ומהירה יותר.' },
    { title: 'ליווי טכני', text: 'צוות לומרה זמין לשאלות טכניות לאורך הפרויקט.' },
  ]}
/>
