---
import DomainPage from '../../layouts/DomainPage.astro';
import { MEDIA } from '../../data/media';

const faq = [
  {
    q: 'איך בית חכם של לומרה משפיע על התשתית בפרויקט?',
    a: 'החשמל מגיע ישירות לגופי התאורה והשליטה אלחוטית, ולכן נדרשת פחות צנרת אל המתגים ופחות נקודות חשמל. את ההשפעה על הפרויקט שלכם נבדוק מול התוכניות.',
  },
  {
    q: 'איך זה עובד עם שינויי דיירים?',
    a: 'רוכש שרוצה להזיז מתג או להוסיף נקודת שליטה לא צריך חציבה: המתג האלחוטי עובר למקום החדש.',
  },
  {
    q: 'אפשר להציע את המערכת כשדרוג לרוכשים?',
    a: 'כן. אפשר להגדיר חבילת בסיס לכל הדירות ושדרוגים לבחירה, ונבנה איתכם את ההצעה לרוכשים.',
  },
];
---

<DomainPage
  faq={faq}
  title="בית חכם לפרויקטים של יזמים וקבלנים | לומרה"
  description="בית חכם כסטנדרט בפרויקט: פחות צנרת ונקודות חשמל, שינויי דיירים בלי חציבות, ומתקינים מוסמכים לפי שיטה מתועדת. ליזמים, קבלנים ומנהלי פרויקטים."
  path="/professionals/developers/"
  h1="בית חכם כסטנדרט בפרויקט, בתשתית פשוטה יותר"
  lead="יזמים וקבלנים יכולים להציע לרוכשים בית חכם מהיום הראשון. החשמל מגיע ישירות לתאורה והשליטה אלחוטית, כך שהתשתית פשוטה יותר ושינויי הדיירים לא מחייבים חציבה."
  crumbs={[
    { name: 'לאנשי מקצוע', path: '/professionals/' },
    { name: 'יזמים וקבלנים', path: '/professionals/developers/' },
  ]}
  image={MEDIA.pages.developers}
  service={{ name: 'בית חכם לפרויקטים של יזמים וקבלנים', serviceType: 'מערכות בית חכם לפרויקטי מגורים' }}
  whatsappMessage="היי, אני יזם/קבלן ורוצה לשמוע על לומרה לפרויקט"
  ctaTitle="בואו נבדוק את הפרויקט שלכם"
  ctaText="שלחו תוכניות או פרטים על הפרויקט, ונחזור עם הצעה למפרט ולשיתוף פעולה."
  featuresTitle="מה זה נותן לפרויקט"
  features={[
    { title: 'תשתית פשוטה יותר', text: 'פחות צנרת אל המתגים ופחות נקודות חשמל. החיסכון נכנס כבר לתוכנית החשמל.' },
    { title: 'שינויי דיירים בלי חציבות', text: 'הזזה או הוספה של מתג היא עניין של הגדרה, לא של עבודות בקיר.' },
    { title: 'יתרון שיווקי ברור', text: 'דירה שמגיעה עם מתגי מגע בעברית, תאורה חכמה ואפליקציה, מהיום הראשון.' },
    { title: 'התקנה לפי שיטה מתועדת', text: 'מתקינים מוסמכים של לומרה עובדים לפי שיטה אחידה, שמתאימה גם להיקפים של פרויקט.' },
  ]}
/>
