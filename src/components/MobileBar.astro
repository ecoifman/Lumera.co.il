---
// Fixed contact bar on phones: the two actions that convert, always one tap away.
import { SITE, whatsappLink } from '../data/site';
import Icon from './Icon.astro';

interface Props {
  whatsappMessage?: string;
}
const { whatsappMessage = 'היי, הגעתי מהאתר של לומרה ואשמח לייעוץ לבית חכם' } = Astro.props;
---

<div class="mobile-bar" data-mobile-bar>
  <a class="mobile-bar__wa" href={whatsappLink(whatsappMessage)} target="_blank" rel="noopener" data-track="whatsapp-mobilebar">
    <Icon name="chat" />
    ייעוץ בוואטסאפ
  </a>
  <a class="mobile-bar__call" href={SITE.phoneHref} data-track="phone-mobilebar">
    <Icon name="phone" />
    <span class="visually-hidden">חיוג ל־</span><span class="ltr" dir="ltr">{SITE.phoneDisplay}</span>
  </a>
</div>

<style>
  .mobile-bar {
    display: none;
  }
  @media (max-width: 40rem) {
    .mobile-bar {
      --focus: var(--lumen);
      position: fixed;
      inset-inline: 0.75rem;
      bottom: calc(0.75rem + env(safe-area-inset-bottom));
      z-index: 40;
      display: grid;
      grid-template-columns: 1.4fr 1fr;
      gap: 0.5rem;
      padding: 0.4rem;
      border-radius: 999px;
      background: rgb(27 31 33 / 0.92);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      box-shadow: 0 12px 40px rgb(0 0 0 / 0.3);
      transform: translateY(calc(100% + 2rem));
      transition: transform 0.6s var(--ease-out);
    }
    .mobile-bar.is-visible {
      transform: translateY(0);
    }
    .mobile-bar a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      min-height: 3rem;
      border-radius: 999px;
      font-size: 0.95rem;
      font-weight: 500;
      text-decoration: none;
    }
    .mobile-bar :global(svg) {
      width: 1.15rem;
      height: 1.15rem;
    }
    .mobile-bar__wa {
      background: var(--plaster);
      color: var(--glass);
    }
    .mobile-bar__call {
      color: var(--plaster);
    }
  }
</style>
