---
// Small inline icon set (stroke icons drawn for this site). Decorative by default.
interface Props {
  name: 'chat' | 'phone' | 'play' | 'pause' | 'menu' | 'close' | 'plus' | 'pin' | 'mail';
  label?: string;
  class?: string;
}
const { name, label, class: className } = Astro.props;
const a11y = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true', focusable: 'false' };
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  {...a11y}
>
  {name === 'chat' && (
    <path d="M20.5 11.6c0 4.4-3.8 7.9-8.5 7.9-1.2 0-2.4-.2-3.4-.7L3.5 20.5l1.5-4.2c-.9-1.3-1.5-2.9-1.5-4.6 0-4.4 3.8-7.9 8.5-7.9s8.5 3.5 8.5 7.8Z" />
  )}
  {name === 'phone' && (
    <path d="M5.2 3.5h3.1l1.6 4.2-2.1 1.4a11.6 11.6 0 0 0 7.1 7.1l1.4-2.1 4.2 1.6v3.1c0 1-.8 1.7-1.8 1.7C10.9 20.5 3.5 13.1 3.5 5.3c0-1 .7-1.8 1.7-1.8Z" />
  )}
  {name === 'play' && <path d="M8 5.5v13l10-6.5-10-6.5Z" />}
  {name === 'pause' && (
    <>
      <path d="M8.5 5.5v13" />
      <path d="M15.5 5.5v13" />
    </>
  )}
  {name === 'menu' && (
    <>
      <path d="M4 8h16" />
      <path d="M4 16h16" />
    </>
  )}
  {name === 'close' && (
    <>
      <path d="m6 6 12 12" />
      <path d="M18 6 6 18" />
    </>
  )}
  {name === 'plus' && (
    <>
      <path d="M12 5v14" />
      <path d="M5 12h14" />
    </>
  )}
  {name === 'pin' && (
    <>
      <path d="M12 21s-6.5-5.8-6.5-11a6.5 6.5 0 0 1 13 0c0 5.2-6.5 11-6.5 11Z" />
      <circle cx="12" cy="10" r="2.3" />
    </>
  )}
  {name === 'mail' && (
    <>
      <rect x="3.5" y="5.5" width="17" height="13" rx="2" />
      <path d="m4 7 8 6 8-6" />
    </>
  )}
</svg>
