---
// The rest of the home: audio, security, climate. Each row pairs a moving
// picture (or a still) with what you get, and links to the full page.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface DomainRow {
  id: string;
  title: string;
  text: string;
  href: string;
  linkLabel: string;
  image: ImageMetadata;
  alt: string;
  video?: { mp4: string; webm?: string };
}
interface Props {
  rows: DomainRow[];
}
const { rows } = Astro.props;
---

<section class="domains surface-light section" id="whole-home" aria-labelledby="domains-title">
  <div class="wrap domains__head">
    <h2 id="domains-title" class="display-3" data-reveal="lines">כל הבית, במערכת אחת</h2>
    <p class="lead measure muted">
      מעבר למתגים ולתאורה: שמע, אבטחה ואקלים נכנסים לאותה מערכת ולאותה אפליקציה, ומתוכננים יחד מהיום הראשון.
    </p>
  </div>

  <div class="domains__list">
    {
      rows.map((row, i) => (
        <article class:list={['domain', { 'domain--flip': i % 2 === 1 }]} aria-labelledby={`domain-${row.id}`}>
          <div class="domain__media wrap-bleed" data-reveal="media">
            <div class="domain__frame" id={`domain-video-${row.id}`} {...(row.video ? { 'data-bg-video': '' } : {})}>
              <Picture src={row.image} alt={row.alt} formats={['avif', 'webp']} widths={[640, 960, 1280, 1600]} sizes="(max-width: 64rem) 100vw, 58vw" data-parallax="6" />
              {row.video && (
                <video muted loop playsinline preload="none" aria-hidden="true" tabindex="-1" disablepictureinpicture>
                  {row.video.webm && <source data-src={row.video.webm} type="video/webm" />}
                  <source data-src={row.video.mp4} type="video/mp4" />
                </video>
              )}
            </div>
            {row.video && (
              <button type="button" class="domain__toggle" data-video-toggle={`domain-video-${row.id}`} data-state="paused">
                <span class="visually-hidden" data-label>
                  הפעלת סרטון הרקע
                </span>
              </button>
            )}
          </div>
          <div class="domain__copy">
            <h3 id={`domain-${row.id}`} class="domain__title">{row.title}</h3>
            <p class="domain__text">{row.text}</p>
            <a class="link-line" href={row.href}>{row.linkLabel}</a>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .domains__head {
    display: grid;
    gap: 1.25rem;
    margin-bottom: clamp(3rem, 7vw, 6rem);
  }
  .domains__list {
    display: grid;
    gap: clamp(4rem, 9vw, 8rem);
  }
  .domain {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
    padding-inline-end: var(--gutter);
  }
  .domain--flip {
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    padding-inline: var(--gutter) 0;
  }
  .domain--flip .domain__media {
    order: 2;
  }
  .domain__media {
    position: relative;
  }
  .domain__frame {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-start-end-radius: var(--radius-panel);
    border-end-end-radius: var(--radius-panel);
  }
  .domain--flip .domain__frame {
    border-radius: 0;
    border-start-start-radius: var(--radius-panel);
    border-end-start-radius: var(--radius-panel);
  }
  .domain__frame :global(picture),
  .domain__frame :global(img),
  .domain__frame video {
    position: absolute;
    inset: -8% 0;
    width: 100%;
    height: 116%;
    object-fit: cover;
  }
  .domain__frame video {
    inset: 0;
    height: 100%;
    opacity: 0;
    transition: opacity 1s var(--ease-out);
  }
  .domain__frame:global(.is-playing) video {
    opacity: 1;
  }
  .domain__toggle {
    position: absolute;
    inset-inline-end: 1rem;
    bottom: 1rem;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid rgb(230 230 225 / 0.5);
    border-radius: 50%;
    background: rgb(27 31 33 / 0.45);
    color: var(--plaster);
    --focus: var(--lumen);
  }
  .domain__toggle::before,
  .domain__toggle::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 2px;
    height: 0.8rem;
    background: currentColor;
    translate: 0 -50%;
  }
  .domain__toggle::before {
    inset-inline-start: calc(50% - 4px);
  }
  .domain__toggle::after {
    inset-inline-start: calc(50% + 2px);
  }
  .domain__toggle[data-state='paused']::before {
    inset-inline-start: calc(50% - 3px);
    width: 0;
    height: 0;
    background: none;
    border-block: 6px solid transparent;
    border-inline-end: 9px solid currentColor;
  }
  .domain__toggle[data-state='paused']::after {
    display: none;
  }
  .domain__title {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 400;
    line-height: 1.12;
  }
  .domain__text {
    margin: 1.25rem 0 1.5rem;
    max-width: 28em;
    color: var(--stone-on-light);
  }

  @media (max-width: 64rem) {
    .domain,
    .domain--flip {
      grid-template-columns: minmax(0, 1fr);
      padding-inline: 0;
    }
    .domain--flip .domain__media {
      order: 0;
    }
    .domain__frame,
    .domain--flip .domain__frame {
      border-radius: 0;
    }
    .domain__copy {
      padding-inline: var(--gutter);
    }
  }
</style>
