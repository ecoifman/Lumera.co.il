---
// The L10 wall screen in four rooms, each with its own design theme. Picking a
// room is a real interaction: the new screen spreads out from the point of touch
// (see initSwitchThemes in ui.ts). The frames come from the explainer film.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface SwitchScreen {
  id: string;
  label: string;
  image: ImageMetadata;
  alt: string;
}
interface Props {
  screens: SwitchScreen[];
  headingLevel?: 'h2' | 'h3';
  showLink?: boolean;
}
const { screens, headingLevel: H = 'h2', showLink = true } = Astro.props;
---

<section class="showcase surface-light section" aria-labelledby="switch-title" data-switch-themes>
  <div class="wrap showcase__grid">
    <div class="showcase__stage" data-theme-stage>
      {
        screens.map((s, i) => (
          <div class:list={['showcase__screen', { 'is-active is-front': i === 0 }]} data-theme-screen={s.id}>
            <Picture
              src={s.image}
              alt={s.alt}
              formats={['avif', 'webp']}
              widths={[480, 720, 960, 1200]}
              sizes="(max-width: 64rem) 90vw, 46vw"
              loading="lazy"
            />
          </div>
        ))
      }
    </div>

    <div class="showcase__copy">
      <H id="switch-title" class="display-3" data-reveal="lines">מתג אחד שיודע להיות הכול</H>
      <p class="lead showcase__lead">
        סדרת <bdi>L10</bdi> היא מסך מגע על הקיר: מתג תאורה, מעמעם, שלט לתריסים ולמזגן ומפעיל סצנות, ביחידה אחת. חיישן קרבה מעיר את המסך כשמתקרבים, והכיתוב בעברית משתנה מתי שרוצים. ולכל חדר אפשר לבחור עיצוב משלו.
      </p>

      <div class="showcase__picker" role="radiogroup" aria-label="בחרו חדר">
        {
          screens.map((s, i) => (
            <button type="button" role="radio" aria-checked={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-theme={s.id}>
              {s.label}
            </button>
          ))
        }
      </div>
      <p class="visually-hidden" aria-live="polite" data-theme-live></p>

      <ul class="showcase__facts">
        <li>שליטה קולית עם Alexa ו־Google</li>
        <li>רקעים וערכות עיצוב שמתחלפים מהאפליקציה</li>
        <li>תאורה, תריסים, דוד ומזגן מאותו מסך</li>
      </ul>
      {showLink && <a class="link-line" href="/switches/">כל המתגים והפאנלים</a>}
    </div>
  </div>
</section>

<style>
  .showcase__grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }
  .showcase__stage {
    position: relative;
    aspect-ratio: 3 / 2;
    border-radius: var(--radius-panel);
    overflow: hidden;
    background: var(--plaster-2);
  }
  .showcase__screen {
    position: absolute;
    inset: 0;
    clip-path: circle(0% at var(--ox, 50%) var(--oy, 50%));
    transition: clip-path 0.95s var(--ease-dimmer);
  }
  .showcase__screen.is-active {
    clip-path: circle(150% at var(--ox, 50%) var(--oy, 50%));
  }
  .showcase__screen :global(picture),
  .showcase__screen :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .showcase__lead {
    margin-top: 1.5rem;
    max-width: 30em;
  }
  .showcase__picker {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 2rem;
  }
  .showcase__picker button {
    min-height: 2.75rem;
    padding: 0.5rem 1.15rem;
    border: 1px solid var(--line-on-light);
    border-radius: var(--radius-key);
    background: transparent;
    font-size: 0.95rem;
    transition:
      background-color 0.35s var(--ease-out),
      color 0.35s var(--ease-out),
      box-shadow 0.35s var(--ease-out),
      border-color 0.35s var(--ease-out);
  }
  .showcase__picker button:hover {
    border-color: var(--glass);
  }
  .showcase__picker button[aria-checked='true'] {
    background: var(--glass);
    color: var(--plaster);
    border-color: var(--glass);
    box-shadow: 0 0 0 1px var(--lumen), 0 0 22px var(--lumen-glow);
  }
  .showcase__facts {
    display: grid;
    gap: 0.6rem;
    margin: 2rem 0;
    padding: 0;
    list-style: none;
  }
  .showcase__facts li {
    position: relative;
    padding-inline-start: 1.4rem;
  }
  .showcase__facts li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: 0.72em;
    width: 0.6rem;
    height: 1px;
    background: var(--glass);
  }
  @media (max-width: 64rem) {
    .showcase__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
